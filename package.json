{
  "name": "dis-morph-svelte",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run scss:variables && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "format:shaders": "clang-format -i src/shaders/*.vert src/shaders/*.frag",
    "scss:variables": "sass-export src/lib/styles/abstracts/_variables.scss --json src/lib/utils/scss-variables.json",
    "deploy": "vite build"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/flubber": "^0.4.0",
    "@types/node": "^24.0.14",
    "clang-format": "^1.8.0",
    "sass": "^1.89.2",
    "sass-export": "^2.1.2",
    "svelte": "^4.0.0",
    "svelte-check": "^3.6.0",
    "svelte-preprocess": "^6.0.3",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-gh-pages": "^1.0.1"
  },
  "dependencies": {
    "flubber": "^0.4.2",
    "gsap": "^3.13.0",
    "regl": "^2.1.0"
  }
}
